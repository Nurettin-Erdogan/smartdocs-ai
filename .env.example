# Copy this file to .env. Never commit the populated .env file.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=SmartDocsAI_Db
POSTGRES_USER=smartdocs
POSTGRES_PASSWORD=

# Use a long, random value (for example: 64+ base64url characters).
JWT_TOKEN_KEY=

# Used only when ASPNETCORE_ENVIRONMENT=Development and the database has no users.
# Leave the password empty in Production; users can register from the UI.
SEED_ADMIN_NAME=SmartDocs Admin
SEED_ADMIN_EMAIL=admin@smartdocs.ai
SEED_ADMIN_PASSWORD=

# Ollama varsayılan olarak aynı Docker Compose yığını içinde çalışır.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BIND_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_WARMUP_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TIMEOUT_SECONDS=0
OLLAMA_NUM_CONTEXT=4096
OLLAMA_TEMPERATURE=0.1

QDRANT_COLLECTION=smartdocs_chunks
QDRANT_VECTOR_SIZE=768

# Optional: Vercel showcase AI. Keep the key server-side; never prefix it with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local Compose ports bind to loopback by default. Set APP_BIND_HOST or
# OLLAMA_BIND_HOST to 0.0.0.0 only when you intentionally need LAN/external access
# and have appropriate firewall/reverse-proxy controls in place.

# Optional: trusted reverse proxy IPs, exposed as environment variables by your platform.
# ProxySettings__KnownProxies__0=10.0.0.10
